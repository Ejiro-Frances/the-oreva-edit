# Local preview uses fixtures. Production must use supabase.
DATA_MODE=fixture
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicitly enable only in isolated development / staging with synthetic data.
ALLOW_TEST_ORDERS=true
FIXTURE_ORDER_FILE=.data/test-orders.json

# Supabase Project Settings > API. Publishable key is safe for browser clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=

# capture (local files) or mailgun. Capture does not send email.
EMAIL_MODE=capture
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_REGION=US
# Long random bearer credential for POST /api/internal/email-worker.
CRON_SECRET=
